#!/usr/bin/env python3
"""cdp 入口：把仓库根目录加进 sys.path 后交给 cdp 包。

install.sh 会把本文件软链到 ~/.local/bin，故先解引用再定位仓库。
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from cdp.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
